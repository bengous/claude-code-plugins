#!/usr/bin/env bun

// git-clean-audit — Scan git branches and worktrees for cleanup candidates.
// Emits structured JSON for the git-sweep pipeline (/git-sweep-audit + git-clean-apply).

import { $ } from "bun";
import { existsSync } from "node:fs";
import { rename } from "node:fs/promises";
import { join } from "node:path";

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

type BranchInfo = {
  name: string;
  ahead: number;
  behind: number;
  last_commit_date: string;
  last_commit_subject: string;
};

type WorktreeInfo = {
  path: string;
  branch: string | null;
  reason: "missing-dir" | "broken-ref";
};

type RemoteBranchInfo = {
  name: string;
  merged: boolean;
  last_commit_date: string;
  last_commit_subject: string;
};

type AuditSuccess = {
  ok: true;
  base: string;
  categories: {
    merged_local: BranchInfo[];
    orphaned_worktree: BranchInfo[];
    squash_merged: BranchInfo[];
    backup: BranchInfo[];
    stale_worktrees: WorktreeInfo[];
    stale_remote: RemoteBranchInfo[];
    stale_tracking: string[];
  };
  kept: string[];
};

type AuditError = {
  ok: false;
  error: string;
  step: "validate" | "scan-local" | "scan-worktrees" | "scan-remote" | "internal";
};

type AuditResult = AuditSuccess | AuditError;

type CleanupManifest = {
  worktrees: string[];
  branches: { name: string; force: boolean }[];
  remote_branches: { remote: string; ref: string }[];
  prune_remotes: boolean;
  prune_worktrees: boolean;
};

type SaveResult = { ok: true; path: string } | { ok: false; error: string };

// ---------------------------------------------------------------------------
// Git helpers
// ---------------------------------------------------------------------------

async function git(...args: string[]): Promise<{ stdout: string; stderr: string; exitCode: number }> {
  const { stdout, stderr, exitCode } = await $`git ${args}`.quiet().nothrow();
  return { stdout: stdout.toString().trim(), stderr: stderr.toString().trim(), exitCode };
}

async function gitOk(...args: string[]): Promise<string> {
  const result = await git(...args);
  if (result.exitCode !== 0) {
    throw new Error(`git ${args[0]} failed: ${result.stderr}`);
  }
  return result.stdout;
}

// ---------------------------------------------------------------------------
// Branch metadata
// ---------------------------------------------------------------------------

async function getBranchInfo(name: string, base: string): Promise<BranchInfo> {
  const [aheadResult, behindResult, dateResult, subjectResult] = await Promise.all([
    git("rev-list", "--count", `${base}..${name}`),
    git("rev-list", "--count", `${name}..${base}`),
    git("log", "-1", "--format=%aI", name),
    git("log", "-1", "--format=%s", name),
  ]);

  return {
    name,
    ahead: parseInt(aheadResult.stdout, 10) || 0,
    behind: parseInt(behindResult.stdout, 10) || 0,
    last_commit_date: dateResult.stdout,
    last_commit_subject: subjectResult.stdout,
  };
}

async function getRemoteBranchInfo(name: string, merged: boolean): Promise<RemoteBranchInfo> {
  const [dateResult, subjectResult] = await Promise.all([
    git("log", "-1", "--format=%aI", name),
    git("log", "-1", "--format=%s", name),
  ]);

  return {
    name,
    merged,
    last_commit_date: dateResult.stdout,
    last_commit_subject: subjectResult.stdout,
  };
}

// ---------------------------------------------------------------------------
// Squash-merge detection
// ---------------------------------------------------------------------------

async function isSquashMerged(branch: string, base: string): Promise<boolean> {
  try {
    const mergeBase = await gitOk("merge-base", base, branch);
    const treeHash = await gitOk("rev-parse", `${branch}^{tree}`);
    const squashCommit = await gitOk("commit-tree", treeHash, "-p", mergeBase, "-m", "temp");
    const cherry = await git("cherry", base, squashCommit);
    return cherry.stdout.startsWith("-");
  } catch {
    return false;
  }
}

// ---------------------------------------------------------------------------
// Worktree scanning
// ---------------------------------------------------------------------------

function parseWorktreeList(porcelain: string, stalePaths: Set<string> = new Set()): Map<string, string> {
  // Returns map of branch name -> worktree path for ACTIVE worktrees only.
  // Stale worktree paths are excluded so their branches fall through to the
  // normal branch classification (merged / orphaned / squash / backup).
  const branchToPath = new Map<string, string>();
  const entries = porcelain.split("\n\n").filter(Boolean);

  for (const entry of entries) {
    const lines = entry.split("\n");
    let path = "";
    let branch = "";
    for (const line of lines) {
      if (line.startsWith("worktree ")) {
        path = line.slice(9);
      }
      if (line.startsWith("branch ")) {
        branch = line.slice(7).replace("refs/heads/", "");
      }
    }
    if (branch && path && !stalePaths.has(path)) {
      branchToPath.set(branch, path);
    }
  }

  return branchToPath;
}

async function findStaleWorktrees(porcelain: string): Promise<WorktreeInfo[]> {
  const stale: WorktreeInfo[] = [];
  const entries = porcelain.split("\n\n").filter(Boolean);

  // Skip the first entry (main worktree)
  for (let i = 1; i < entries.length; i++) {
    const lines = entries[i]!.split("\n");
    let path = "";
    let branch: string | null = null;
    let isLocked = false;
    let isPrunable = false;

    for (const line of lines) {
      if (line.startsWith("worktree ")) {
        path = line.slice(9);
      }
      if (line.startsWith("branch ")) {
        branch = line.slice(7).replace("refs/heads/", "");
      }
      if (line === "locked") {
        isLocked = true;
      }
      if (line.startsWith("prunable")) {
        isPrunable = true;
      }
    }

    if (!path) continue;

    if (isPrunable) {
      stale.push({ path, branch, reason: "missing-dir" });
    } else if (!existsSync(path)) {
      stale.push({ path, branch, reason: "missing-dir" });
    } else if (isLocked) {
      // Check if the lock is stale (locked but dir missing or branch gone)
      const branchCheck = branch ? await git("rev-parse", "--verify", `refs/heads/${branch}`) : { exitCode: 1 };
      if (branchCheck.exitCode !== 0) {
        stale.push({ path, branch, reason: "broken-ref" });
      }
    }
  }

  return stale;
}

// ---------------------------------------------------------------------------
// Manifest hand-off (durable audit -> apply)
// ---------------------------------------------------------------------------

function isValidManifest(m: unknown): m is CleanupManifest {
  if (typeof m !== "object" || m === null) return false;
  const o = m as Record<string, unknown>;
  if (!Array.isArray(o.worktrees) || !o.worktrees.every((w) => typeof w === "string")) return false;
  if (
    !Array.isArray(o.branches) ||
    !o.branches.every(
      (b) =>
        typeof b === "object" &&
        b !== null &&
        typeof (b as { name?: unknown }).name === "string" &&
        typeof (b as { force?: unknown }).force === "boolean",
    )
  ) {
    return false;
  }
  if (
    !Array.isArray(o.remote_branches) ||
    !o.remote_branches.every(
      (r) =>
        typeof r === "object" &&
        r !== null &&
        typeof (r as { remote?: unknown }).remote === "string" &&
        typeof (r as { ref?: unknown }).ref === "string",
    )
  ) {
    return false;
  }
  if (typeof o.prune_remotes !== "boolean") return false;
  if (typeof o.prune_worktrees !== "boolean") return false;
  return true;
}

// Persist {manifest, kept} (read from stdin) to a fixed repo-scoped file so the
// hand-off to /git-sweep-apply survives context compaction. Atomic: tmp + rename.
async function saveManifest(): Promise<SaveResult> {
  const raw = await Bun.stdin.text();
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return { ok: false, error: "invalid JSON on stdin" };
  }
  if (typeof parsed !== "object" || parsed === null) {
    return { ok: false, error: "expected a {manifest, kept} object on stdin" };
  }
  const { manifest, kept } = parsed as { manifest?: unknown; kept?: unknown };
  if (!isValidManifest(manifest)) {
    return { ok: false, error: "invalid manifest shape" };
  }
  if (!Array.isArray(kept) || !kept.every((k) => typeof k === "string")) {
    return { ok: false, error: "invalid kept list (expected string[])" };
  }

  const gitDir = await git("rev-parse", "--absolute-git-dir");
  if (gitDir.exitCode !== 0) {
    return { ok: false, error: `git rev-parse --absolute-git-dir failed: ${gitDir.stderr}` };
  }

  const path = join(gitDir.stdout, "git-sweep-manifest.json");
  const tmp = `${path}.tmp`;
  await Bun.write(tmp, JSON.stringify({ manifest, kept }, null, 2));
  await rename(tmp, path);
  return { ok: true, path };
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

async function main(): Promise<AuditResult | SaveResult> {
  const args = Bun.argv.slice(2);

  // Save-manifest mode: durable hand-off writer, not a scan.
  if (args.includes("--save-manifest")) {
    return saveManifest();
  }

  let base = "main";
  let includeRemote = false;
  let maxAgeDays = 180;

  for (let i = 0; i < args.length; i++) {
    switch (args[i]) {
      case "--base":
        base = args[++i]!;
        break;
      case "--include-remote":
        includeRemote = true;
        break;
      case "--max-age": {
        maxAgeDays = parseInt(args[++i]!, 10);
        break;
      }
      default:
        return { ok: false, error: `unknown argument: ${args[i]}`, step: "validate" };
    }
  }

  // Validate base branch exists
  const baseCheck = await git("rev-parse", "--verify", base);
  if (baseCheck.exitCode !== 0) {
    return { ok: false, error: `base branch '${base}' not found`, step: "validate" };
  }

  try {
    // Get current branch (to exclude from cleanup)
    const currentBranch = (await git("branch", "--show-current")).stdout;

    // Get worktree info for cross-referencing. A failure here is fatal (rather
    // than silently treating the tree as worktree-free).
    const worktreeList = await git("worktree", "list", "--porcelain");
    if (worktreeList.exitCode !== 0) {
      return { ok: false, error: `git worktree list failed: ${worktreeList.stderr}`, step: "scan-worktrees" };
    }
    const worktreeListRaw = worktreeList.stdout;

    // Identify stale worktrees FIRST, then exclude their paths when building the
    // active branch->worktree map. This lets a stale worktree's branch flow into
    // the normal deletion classification instead of being retained as "active".
    const stale_worktrees = await findStaleWorktrees(worktreeListRaw);
    const stalePaths = new Set(stale_worktrees.map((w) => w.path));
    const branchWorktreeMap = parseWorktreeList(worktreeListRaw, stalePaths);

    // -------------------------------------------------------------------------
    // Scan local branches
    // -------------------------------------------------------------------------

    // Get merged branches (a failed listing is fatal, not an empty result)
    const mergedResult = await git("branch", "--merged", base, "--format=%(refname:short)");
    if (mergedResult.exitCode !== 0) {
      return { ok: false, error: `git branch --merged failed: ${mergedResult.stderr}`, step: "scan-local" };
    }
    const mergedSet = new Set(
      mergedResult.stdout.split("\n").filter(Boolean).filter((b) => b !== base && b !== currentBranch),
    );

    // Get all local branches
    const allBranchesResult = await git("branch", "--format=%(refname:short)");
    if (allBranchesResult.exitCode !== 0) {
      return { ok: false, error: `git branch failed: ${allBranchesResult.stderr}`, step: "scan-local" };
    }
    const allBranches = allBranchesResult.stdout.split("\n").filter(Boolean);

    const kept: string[] = [base];
    if (currentBranch && currentBranch !== base) {
      kept.push(currentBranch);
    }

    const merged_local: BranchInfo[] = [];
    const orphaned_worktree: BranchInfo[] = [];
    const squash_merged: BranchInfo[] = [];
    const backup: BranchInfo[] = [];
    const unclassified: string[] = [];

    const maxAgeDate = new Date();
    maxAgeDate.setDate(maxAgeDate.getDate() - maxAgeDays);

    for (const branch of allBranches) {
      // Skip protected branches
      if (branch === base || branch === currentBranch) continue;

      // Skip branches with active worktrees
      if (branchWorktreeMap.has(branch)) {
        kept.push(branch);
        continue;
      }

      if (mergedSet.has(branch)) {
        // Category 1 or 2: merged -- check if it's an orphaned worktree branch
        if (branch.startsWith("worktree-agent-")) {
          orphaned_worktree.push(await getBranchInfo(branch, base));
        } else {
          merged_local.push(await getBranchInfo(branch, base));
        }
      } else if (branch.startsWith("backup/")) {
        // Category 4: backup branch
        backup.push(await getBranchInfo(branch, base));
      } else if (branch.startsWith("worktree-agent-")) {
        // Unmerged worktree-agent branch -- still orphaned
        orphaned_worktree.push(await getBranchInfo(branch, base));
      } else {
        // Candidate for squash-merge detection
        unclassified.push(branch);
      }
    }

    // Squash-merge detection for unclassified branches (gated by max-age)
    for (const branch of unclassified) {
      const info = await getBranchInfo(branch, base);
      const commitDate = new Date(info.last_commit_date);

      if (commitDate >= maxAgeDate && (await isSquashMerged(branch, base))) {
        squash_merged.push(info);
      } else {
        kept.push(branch);
      }
    }

    // -------------------------------------------------------------------------
    // Scan remote branches (origin-only, non-destructive)
    // -------------------------------------------------------------------------

    const stale_remote: RemoteBranchInfo[] = [];
    let stale_tracking: string[] = [];

    if (includeRemote) {
      // Origin-presence gate: no origin -> fully local, no network, refs intact.
      const originCheck = await git("remote", "get-url", "origin");
      if (originCheck.exitCode === 0) {
        // Non-destructive refresh: update remote-tracking refs WITHOUT pruning
        // (pruning stays a confirmed apply op) and without clobbering FETCH_HEAD.
        // Fail-closed: never proceed on stale remote data when offline.
        const fetchResult = await git("fetch", "--no-prune", "--no-write-fetch-head", "origin");
        if (fetchResult.exitCode !== 0) {
          return { ok: false, error: `git fetch origin failed: ${fetchResult.stderr}`, step: "scan-remote" };
        }

        // Merged remote branches (origin-only: fetch/prune are origin-specific)
        const mergedRemoteResult = await git("branch", "-r", "--merged", base, "--format=%(refname:short)");
        if (mergedRemoteResult.exitCode !== 0) {
          return { ok: false, error: `git branch -r --merged failed: ${mergedRemoteResult.stderr}`, step: "scan-remote" };
        }
        const mergedRemotes = mergedRemoteResult.stdout
          .split("\n")
          .filter(Boolean)
          .filter((b) => b.startsWith("origin/") && !b.endsWith("/HEAD") && !b.endsWith(`/${base}`));

        // All remote branches (reject any non-origin prefix)
        const allRemoteResult = await git("branch", "-r", "--format=%(refname:short)");
        if (allRemoteResult.exitCode !== 0) {
          return { ok: false, error: `git branch -r failed: ${allRemoteResult.stderr}`, step: "scan-remote" };
        }
        const allRemotes = allRemoteResult.stdout
          .split("\n")
          .filter(Boolean)
          .filter((b) => b.startsWith("origin/") && !b.endsWith("/HEAD") && !b.endsWith(`/${base}`));

        const mergedRemoteSet = new Set(mergedRemotes);

        for (const remoteBranch of allRemotes) {
          if (mergedRemoteSet.has(remoteBranch)) {
            stale_remote.push(await getRemoteBranchInfo(remoteBranch, true));
          }
        }

        // Stale tracking refs: refs whose upstream is gone. With --no-prune above,
        // `remote prune --dry-run` reports them honestly (populating stale_tracking
        // so apply can prune them under confirmation).
        const pruneResult = await git("remote", "prune", "origin", "--dry-run");
        if (pruneResult.stdout) {
          stale_tracking = pruneResult.stdout
            .split("\n")
            .filter((line) => line.includes("would prune"))
            .map((line) => line.replace(/^.*\[would prune\]\s*/, "").trim())
            .filter(Boolean);
        }
      }
    }

    return {
      ok: true,
      base,
      categories: {
        merged_local,
        orphaned_worktree,
        squash_merged,
        backup,
        stale_worktrees,
        stale_remote,
        stale_tracking,
      },
      kept,
    };
  } catch (err) {
    // Catch-all: any in-process exception still emits one valid AuditError JSON.
    return {
      ok: false,
      error: `internal error: ${err instanceof Error ? err.message : String(err)}`,
      step: "internal",
    };
  }
}

if (import.meta.main) {
  const result = await main();
  console.log(JSON.stringify(result, null, 2));
  process.exit(result.ok ? 0 : 1);
}
