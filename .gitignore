# Claude Code - track project config, ignore personal/runtime state
.claude/memory.json
.claude/settings.local.json
.claude/exports/
.claude/rebase/
.t-plan/
plans/

# Node/Bun
node_modules/

# Claude Code writes one at a mod's root, when it has none, at each --plugin-dir load; it extends the untracked
# .claude-plugin/types/. A plugin's own tsconfig.json, vellum's, is tracked, which no ignore pattern affects.
/*/tsconfig.json

# Playwright's traces of failed e2e tests
vellum/test-results/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Temp files
*.tmp
*.bak
*.log

# Local working drafts
.issues/
.ideas/
docs/superpowers/specs/

# Claude Code sandbox bind mounts
# The sandbox enforces denyWithinAllow by creating empty read-only files
# and mounting them as ro bind mounts at protected paths. These exist only
# during Claude Code sessions and cannot be deleted (they are mount points).
/HEAD
/config
/hooks
/objects
/refs
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.ripgreprc

# External reference repos (submodules tracked, ignore stray zips)
*.zip
.external/

