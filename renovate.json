{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["dev"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "A major waits for the owner: no auto-merge, and a label that names it.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major"]
    },
    {
      "description": "factory/templates/ holds the trial repository's files as they ran there: an update is played in the trial first, then copied by hand.",
      "matchFileNames": ["factory/templates/**"],
      "enabled": false
    }
  ]
}
