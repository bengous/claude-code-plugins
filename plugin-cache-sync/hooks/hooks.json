{
  "description": "Validates and cold-loads every plugin edited during the session before the turn ends",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-edited-plugins.sh\"",
            "timeout": 60,
            "statusMessage": "Checking edited plugins..."
          }
        ]
      }
    ]
  }
}
