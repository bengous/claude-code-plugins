{
  "name": "claude-plugins-repo",
  "private": true,
  "type": "module",
  "description": "Dev dependencies and tooling config for the TypeScript sources in this marketplace",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint:ts": "oxlint",
    "fmt": "oxfmt '**/*.ts' '**/*.tsx' '**/*.js' '**/*.mjs' '**/*.cjs'",
    "fmt:check": "oxfmt --check '**/*.ts' '**/*.tsx' '**/*.js' '**/*.mjs' '**/*.cjs'",
    "lint:sh": "bun ./scripts/lint-shell.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.82.0",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  }
}
