{
  "description": "Lints a plan before it is approved, captures it, and attaches it to the pull request that lands it",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/gate-plan.ts\"",
            "timeout": 10,
            "statusMessage": "Linting the plan..."
          },
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/capture-plan.ts\"",
            "timeout": 10,
            "statusMessage": "Capturing the plan..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/stamp-plan.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/attach-plan.ts\"",
            "timeout": 30,
            "statusMessage": "Attaching the plan to the PR..."
          }
        ]
      }
    ]
  }
}
