{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  // ─────────────────────────────────────────────────────────────────────────
  // Git & Output
  // ─────────────────────────────────────────────────────────────────────────
  "includeCoAuthoredBy": false,  // Don't add "Co-authored-by: Claude" to commits

  // ─────────────────────────────────────────────────────────────────────────
  // Model & Thinking
  // ─────────────────────────────────────────────────────────────────────────
  "model": "opus",                    // Default model for new conversations
  "alwaysThinkingEnabled": true,      // Extended thinking for complex tasks
  "hasOpusPlanDefault": true,         // Use Opus for planning mode
  "autoUpdates": true,

  // ─────────────────────────────────────────────────────────────────────────
  // Plugins
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Root AGENTS.md delegates plugin authoring to /plugin-dev; declare it so
  // contributors get it. The claude-code-guide agent is built in, not a plugin.
  //
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },

  // ─────────────────────────────────────────────────────────────────────────
  // MCP
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Approve the repo-declared docs server (root .mcp.json) without a prompt.
  //
  "enabledMcpjsonServers": [
    "claude-code-docs"
  ],

  // ─────────────────────────────────────────────────────────────────────────
  // Hooks - SessionStart checks
  // ─────────────────────────────────────────────────────────────────────────
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-code-types.ts\"",
            "timeout": 10,
            "statusMessage": "Checking vellum's plugin types..."
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-sweep.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-check.sh\" --quiet"
          },
          {
            // A cloud session alone: the tools of mise.lock, which its environment cannot install before the clone.
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-tools.sh\"",
            "timeout": 120
          },
          {
            // The factory's verify hook, in a cloud session alone: it records the working tree the session starts from.
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-verify.sh\" start"
          },
          {
            // A first run clones the private repository .private.env names.
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/private-sync.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        // The pre-commit job block-settings-json is the authority; this only
        // surfaces the same rule at edit time instead of at commit time.
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-settings-json.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        // The factory's workflows take a label written with the owner's token
        // as the owner's, and a session here writes with it.
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-owner-labels.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        // A model judges each commit message before the commit runs.
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "if": "Bash(git commit *)",
            "continueOnBlock": true,
            "prompt": "You check the message of a git commit before it runs. Allow at once any command that runs no git commit. A commit message says what the code does now, and why, as facts a reader can check on this commit alone, years later. How the change came about and how it was checked belong in the pull request.\nRefuse the commit when a passage of its message does one of these:\n- explains the change by what produced it: a review, an audit, their findings, a round of feedback, a session, a conversation, a person's decision or request, a plan step or decision label;\n- reports a check as an event: a test seen red before the fix, before and after numbers, a check in a browser, a run id, an eval score, who reviewed the change.\nAllow: the defect itself, even told in the past tense as what the old code did; what a test feeds in, asserts or cannot see; a measured fact about a dependency or platform that explains the code; a bare issue or pull request number; a trailer that names the session or an author; what a prompt, a skill, a script, a check or a review of the repository says or does, told as its behaviour and not as something that happened once; the words review, audit or session when the change itself is about that thing.\nThe message is what the command's -m, --trailer and heredoc values carry. Allow a command whose message you cannot read.\nWhen you refuse, quote each passage and say it belongs in the pull request."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        // Applies oxlint's safe fixes to the file just written and formats it
        // (oxfmt, shfmt), and hands the diff back to the agent. Never blocks.
        // The Stop and SubagentStop gates are the agent-hooks plugin's
        // (`.claude/agent-hooks.jsonc`).
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.ts\"",
            "timeout": 30,
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        // A model reminds a session that creates a tool to check first what
        // Claude Code, gh and this repository already do. A hook's `if` reads
        // the tool name as written and expands no braces: `Edit(*.ts)` and
        // `Write(*.{ts,sh})` match no Write.
        "matcher": "Write",
        "hooks": [
          {
            "type": "prompt",
            "if": "Write(*.ts)",
            "continueOnBlock": true,
            "prompt": "You remind a coding session, at the moment it creates a file, to check whether what the file builds already exists. The hook input below is a Write call: tool_input.file_path, tool_input.content, and tool_response.type.\nAnswer ok:true at once when tool_response.type is not \"create\": the file existed.\nAnswer ok:true when the new file is a test, a spec, a fixture or a test helper, a config file (such as *.config.ts), or a module with no entry point that other code imports.\nAnswer ok:false when the new file is a tool a person, a session or a workflow runs: a script with an entry point (a main function, a shebang, argv parsing, a usage line), such as a wrapper of gh, git or GitHub's API, a wait or a poll on CI, a watcher, a runner, a hook script.\nWhen you answer ok:false, the reason is this text, <path> being the file's path relative to the input's cwd: \"You just created <path>, a new tool. Before you go on, check whether Claude Code (the skills and slash commands listed in your context, `claude --help`), gh, or a script of this repository already does what it does. Say in one line what you found, then go on: this is a reminder, the file stays.\"\n\n$ARGUMENTS"
          }
        ]
      },
      {
        // The factory's verify hook, which acts in a cloud session alone: it
        // records the working tree each time the verify skill runs.
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-verify.sh\" record"
          }
        ]
      }
    ],
    "Stop": [
      {
        // Sends a cloud session back to the verify skill while its working
        // tree differs from the one it started from and from the one verify
        // last saw.
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-verify.sh\" stop"
          }
        ]
      }
    ]
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Permissions
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Sorted by reversibility: allow what stays on this machine or git undoes,
  // ask before what git cannot undo, deny secrets and system damage. No rule
  // here guards a push: a ruleset refuses every direct push to dev, and the
  // owner's machine carries a global guard-git-push hook that refuses a push
  // to main of a public repository. Nor does one guard the labels the owner
  // alone writes: guard-owner-labels.ts does.
  //
  "permissions": {
    // Reversible and local: run without confirmation
    "allow": [
      // Reads of the tree
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",

      // Reads of the system's packages (Arch Linux)
      "Bash(pacman -Q:*)",   // Query installed packages
      "Bash(pacman -Ss:*)",  // Search repos
      "Bash(pacman -Si:*)",  // Package info
      "Bash(pacman -Ql:*)",  // List package files

      // Reads of GitHub
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",

      // Reads of the web, for documentation
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.npmjs.com)",

      // Edits of the tree, which git shows and undoes
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",

      // The gates and the suites a session runs on its change before a push.
      "Bash(bun ./scripts/gates/run-gates.ts *)",
      "Bash(bun test *)",

      // The leads pipeline (docs/repo-ops/leads.md), run by cloud scheduled tasks: these scripts are
      // its only writers to GitHub (issues, comments, labels through `gh api`, under the user's
      // identity), and gate.ts alone fires the scan tasks. Each refuses any file but its own under
      // .leads/, and scan.ts acts only on the scan issue its claim holds. scripts/leads/guard.ts, a
      // PreToolUse hook of the leads skills, denies every other Bash command and every other write.
      "Bash(bun ./scripts/leads/gate.ts collect)",
      "Bash(bun ./scripts/leads/gate.ts collect *)",
      "Bash(bun ./scripts/leads/gate.ts decide --file .leads/verdicts.json)",
      "Bash(bun ./scripts/leads/scan.ts claim *)",
      "Bash(bun ./scripts/leads/scan.ts search *)",
      "Bash(bun ./scripts/leads/scan.ts publish *)",
      "Bash(bun ./scripts/leads/scan.ts release *)",

      // Blankets that also reach past this machine (a publish, an install, a
      // POST): kept as they are until a measured use narrows them.
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(curl:*)"
    ],

    // What git cannot undo: ask first
    "ask": [
      "Bash(pacman -S:*)",   // Install packages
      "Bash(pacman -U:*)",   // Install local packages
      "Bash(pacman -R:*)"    // Remove packages
    ],

    // ─────────────────────────────────────────────────────────────────────
    // DENY LIST - Security-critical operations
    // ─────────────────────────────────────────────────────────────────────
    //
    // These commands are NEVER allowed, even with confirmation.
    // Organized by category for maintainability.
    //
    "deny": [
      // ═══════════════════════════════════════════════════════════════════
      // Secret/Password Managers
      // ═══════════════════════════════════════════════════════════════════
      "Bash(pass :*)",
      "Bash(pass)",
      "Bash(bw get:*)",       // Bitwarden CLI
      "Bash(bw get)",
      "Bash(bw list:*)",
      "Bash(bw list)",
      "Bash(bw export:*)",
      "Bash(bw export)",
      "Bash(secret-tool :*)", // GNOME keyring
      "Bash(secret-tool)",
      "Bash(keyctl :*)",      // Linux kernel keyring
      "Bash(keyctl)",

      // ═══════════════════════════════════════════════════════════════════
      // Encryption/Decryption Tools
      // ═══════════════════════════════════════════════════════════════════
      "Bash(age -d :*)",
      "Bash(age -d)",
      "Bash(age --decrypt:*)",
      "Bash(gpg -d :*)",
      "Bash(gpg -d)",
      "Bash(gpg --decrypt:*)",
      "Bash(sops -d :*)",
      "Bash(sops -d)",
      "Bash(sops --decrypt:*)",
      "Bash(openssl enc -d:*)",
      "Bash(ansible-vault decrypt:*)",
      "Bash(vault :*)",       // HashiCorp Vault
      "Bash(vault)",

      // ═══════════════════════════════════════════════════════════════════
      // Environment & Credential Inspection
      // ═══════════════════════════════════════════════════════════════════
      "Bash(env :*)",
      "Bash(env)",
      "Bash(printenv :*)",
      "Bash(printenv)",
      "Bash(export -p :*)",
      "Bash(export -p)",
      "Bash(set :*)",
      "Bash(set)",
      "Bash(declare -p:*)",
      "Bash(history :*)",
      "Bash(fc -l:*)",

      // ═══════════════════════════════════════════════════════════════════
      // Cloud & Infrastructure Credentials
      // ═══════════════════════════════════════════════════════════════════
      "Bash(aws configure list:*)",
      "Bash(aws configure get:*)",
      "Bash(gcloud auth :*)",
      "Bash(gcloud auth)",
      "Bash(kubectl config view :*)",
      "Bash(kubectl config view)",
      "Bash(docker secret :*)",
      "Bash(docker secret)",
      "Bash(git config --get credential :*)",
      "Bash(git config --get credential)",
      "Bash(ssh-add -L :*)",
      "Bash(ssh-add -L)",
      "Bash(ssh-add -l:*)",

      // ═══════════════════════════════════════════════════════════════════
      // Sensitive File Reads (via Read tool)
      // ═══════════════════════════════════════════════════════════════════
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_key)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/age/**)",

      // Project secrets
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/vault.yml)",
      "Read(**/vault.yaml)",
      "Read(**/credentials.json)",
      "Read(./secrets/**)",

      // ═══════════════════════════════════════════════════════════════════
      // Destructive System Commands
      // ═══════════════════════════════════════════════════════════════════
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chown -R:*)"
    ]
  }
}
