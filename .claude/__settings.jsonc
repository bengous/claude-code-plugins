{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  // ─────────────────────────────────────────────────────────────────────────
  // Git & Output
  // ─────────────────────────────────────────────────────────────────────────
  "includeCoAuthoredBy": false,  // Don't add "Co-authored-by: Claude" to commits

  // ─────────────────────────────────────────────────────────────────────────
  // Model & Thinking
  // ─────────────────────────────────────────────────────────────────────────
  "model": "opus",                    // Default model for new conversations
  "alwaysThinkingEnabled": true,      // Extended thinking for complex tasks
  "hasOpusPlanDefault": true,         // Use Opus for planning mode
  "autoUpdates": true,

  // ─────────────────────────────────────────────────────────────────────────
  // Plugins
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Root AGENTS.md delegates plugin authoring to /plugin-dev; declare it so
  // contributors get it. The claude-code-guide agent is built in, not a plugin.
  //
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },

  // ─────────────────────────────────────────────────────────────────────────
  // MCP
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Approve the repo-declared docs server (root .mcp.json) without a prompt.
  //
  "enabledMcpjsonServers": [
    "claude-code-docs"
  ],

  // ─────────────────────────────────────────────────────────────────────────
  // Hooks - SessionStart checks
  // ─────────────────────────────────────────────────────────────────────────
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-code-types.ts\"",
            "timeout": 10,
            "statusMessage": "Checking vellum's plugin types..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-check.sh\" --quiet"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.ts\"",
            "timeout": 5
          },
          {
            // The GitHub rulesets accept a fast-forward push to main and a
            // linear force push to dev; this hook refuses both agent-side.
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-push.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        // The pre-commit job block-settings-json is the authority; this only
        // surfaces the same rule at edit time instead of at commit time.
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-settings-json.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        // Applies oxlint's safe fixes to the file just written and formats it
        // (oxfmt, shfmt), and hands the diff back to the agent. Never blocks.
        // The Stop and SubagentStop gates are the agent-hooks plugin's
        // (`.claude/agent-hooks.jsonc`).
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.ts\"",
            "timeout": 30,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  },

  // ─────────────────────────────────────────────────────────────────────────
  // Permissions
  // ─────────────────────────────────────────────────────────────────────────
  //
  // Sorted by reversibility: allow what stays on this machine or git undoes,
  // ask before what git cannot undo, deny secrets and system damage. The
  // one-way doors of a push (main, a force push to dev, a release) are refused
  // by a PreToolUse hook, not by a rule here.
  //
  "permissions": {
    // Reversible and local: run without confirmation
    "allow": [
      // Reads of the tree
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",

      // Reads of the system's packages (Arch Linux)
      "Bash(pacman -Q:*)",   // Query installed packages
      "Bash(pacman -Ss:*)",  // Search repos
      "Bash(pacman -Si:*)",  // Package info
      "Bash(pacman -Ql:*)",  // List package files

      // Reads of GitHub
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",

      // Reads of the web, for documentation
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.npmjs.com)",

      // Edits of the tree, which git shows and undoes
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",

      // Landing a reviewed branch on dev: the script pushes only a feature/ or
      // fix/ branch and its fast-forward to dev, refuses before any push unless
      // its PR is open against dev and green, and the pre-push gates still run.
      "Bash(bun ./scripts/land.ts *)",

      // Blankets that also reach past this machine (a publish, an install, a
      // POST): kept as they are until a measured use narrows them.
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(curl:*)"
    ],

    // What git cannot undo: ask first
    "ask": [
      "Bash(pacman -S:*)",   // Install packages
      "Bash(pacman -U:*)",   // Install local packages
      "Bash(pacman -R:*)"    // Remove packages
    ],

    // ─────────────────────────────────────────────────────────────────────
    // DENY LIST - Security-critical operations
    // ─────────────────────────────────────────────────────────────────────
    //
    // These commands are NEVER allowed, even with confirmation.
    // Organized by category for maintainability.
    //
    "deny": [
      // ═══════════════════════════════════════════════════════════════════
      // Secret/Password Managers
      // ═══════════════════════════════════════════════════════════════════
      "Bash(pass :*)",
      "Bash(pass)",
      "Bash(bw get:*)",       // Bitwarden CLI
      "Bash(bw get)",
      "Bash(bw list:*)",
      "Bash(bw list)",
      "Bash(bw export:*)",
      "Bash(bw export)",
      "Bash(secret-tool :*)", // GNOME keyring
      "Bash(secret-tool)",
      "Bash(keyctl :*)",      // Linux kernel keyring
      "Bash(keyctl)",

      // ═══════════════════════════════════════════════════════════════════
      // Encryption/Decryption Tools
      // ═══════════════════════════════════════════════════════════════════
      "Bash(age -d :*)",
      "Bash(age -d)",
      "Bash(age --decrypt:*)",
      "Bash(gpg -d :*)",
      "Bash(gpg -d)",
      "Bash(gpg --decrypt:*)",
      "Bash(sops -d :*)",
      "Bash(sops -d)",
      "Bash(sops --decrypt:*)",
      "Bash(openssl enc -d:*)",
      "Bash(ansible-vault decrypt:*)",
      "Bash(vault :*)",       // HashiCorp Vault
      "Bash(vault)",

      // ═══════════════════════════════════════════════════════════════════
      // Environment & Credential Inspection
      // ═══════════════════════════════════════════════════════════════════
      "Bash(env :*)",
      "Bash(env)",
      "Bash(printenv :*)",
      "Bash(printenv)",
      "Bash(export -p :*)",
      "Bash(export -p)",
      "Bash(set :*)",
      "Bash(set)",
      "Bash(declare -p:*)",
      "Bash(history :*)",
      "Bash(fc -l:*)",

      // ═══════════════════════════════════════════════════════════════════
      // Cloud & Infrastructure Credentials
      // ═══════════════════════════════════════════════════════════════════
      "Bash(aws configure list:*)",
      "Bash(aws configure get:*)",
      "Bash(gcloud auth :*)",
      "Bash(gcloud auth)",
      "Bash(kubectl config view :*)",
      "Bash(kubectl config view)",
      "Bash(docker secret :*)",
      "Bash(docker secret)",
      "Bash(git config --get credential :*)",
      "Bash(git config --get credential)",
      "Bash(ssh-add -L :*)",
      "Bash(ssh-add -L)",
      "Bash(ssh-add -l:*)",

      // ═══════════════════════════════════════════════════════════════════
      // Sensitive File Reads (via Read tool)
      // ═══════════════════════════════════════════════════════════════════
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_key)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/age/**)",

      // Project secrets
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/vault.yml)",
      "Read(**/vault.yaml)",
      "Read(**/credentials.json)",
      "Read(./secrets/**)",

      // ═══════════════════════════════════════════════════════════════════
      // Destructive System Commands
      // ═══════════════════════════════════════════════════════════════════
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chown -R:*)"
    ]
  }
}
