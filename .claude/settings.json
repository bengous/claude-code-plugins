{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "hasOpusPlanDefault": true,
  "autoCompactEnabled": false,
  "autoUpdates": true,
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "claude-code-docs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/regenerate-plugin-types.ts\"",
            "timeout": 30,
            "statusMessage": "Checking vellum's plugin types..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-check.sh\" --quiet"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main-branch.ts\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-push.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-settings-json.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.ts\"",
            "timeout": 30,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gates.ts\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gates.ts\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(pacman -Q:*)",
      "Bash(pacman -Ss:*)",
      "Bash(pacman -Si:*)",
      "Bash(pacman -Ql:*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",
      "Bash(curl:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.npmjs.com)"
    ],
    "ask": [
      "Bash(pacman -S:*)",
      "Bash(pacman -U:*)",
      "Bash(pacman -R:*)"
    ],
    "deny": [
      "Bash(pass :*)",
      "Bash(pass)",
      "Bash(bw get:*)",
      "Bash(bw get)",
      "Bash(bw list:*)",
      "Bash(bw list)",
      "Bash(bw export:*)",
      "Bash(bw export)",
      "Bash(secret-tool :*)",
      "Bash(secret-tool)",
      "Bash(keyctl :*)",
      "Bash(keyctl)",
      "Bash(age -d :*)",
      "Bash(age -d)",
      "Bash(age --decrypt:*)",
      "Bash(gpg -d :*)",
      "Bash(gpg -d)",
      "Bash(gpg --decrypt:*)",
      "Bash(sops -d :*)",
      "Bash(sops -d)",
      "Bash(sops --decrypt:*)",
      "Bash(openssl enc -d:*)",
      "Bash(ansible-vault decrypt:*)",
      "Bash(vault :*)",
      "Bash(vault)",
      "Bash(env :*)",
      "Bash(env)",
      "Bash(printenv :*)",
      "Bash(printenv)",
      "Bash(export -p :*)",
      "Bash(export -p)",
      "Bash(set :*)",
      "Bash(set)",
      "Bash(declare -p:*)",
      "Bash(history :*)",
      "Bash(fc -l:*)",
      "Bash(aws configure list:*)",
      "Bash(aws configure get:*)",
      "Bash(gcloud auth :*)",
      "Bash(gcloud auth)",
      "Bash(kubectl config view :*)",
      "Bash(kubectl config view)",
      "Bash(docker secret :*)",
      "Bash(docker secret)",
      "Bash(git config --get credential :*)",
      "Bash(git config --get credential)",
      "Bash(ssh-add -L :*)",
      "Bash(ssh-add -L)",
      "Bash(ssh-add -l:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_key)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/age/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/vault.yml)",
      "Read(**/vault.yaml)",
      "Read(**/credentials.json)",
      "Read(./secrets/**)",
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chown -R:*)"
    ]
  }
}
