{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "model": "opus",
  "alwaysThinkingEnabled": true,
  "hasOpusPlanDefault": true,
  "autoUpdates": true,
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "claude-code-docs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-code-types.ts\"",
            "timeout": 10,
            "statusMessage": "Checking vellum's plugin types..."
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-sweep.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/renovate-agent.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/setup-check.sh\" --quiet"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/private-sync.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-settings-json.ts\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "if": "Bash(git commit *)",
            "continueOnBlock": true,
            "prompt": "You check the message of a git commit before it runs. A commit message says what the code does now, and why, as facts a reader can check on this commit alone, years later. How the change came about and how it was checked belong in the pull request.\nRefuse the commit when a passage of its message does one of these:\n- explains the change by what produced it: a review, an audit, their findings, a round of feedback, a session, a conversation, a person's decision or request, a plan step or decision label;\n- reports a check as an event: a test seen red before the fix, before and after numbers, a check in a browser, a run id, an eval score, who reviewed the change.\nAllow: the defect itself, even told in the past tense as what the old code did; what a test feeds in, asserts or cannot see; a measured fact about a dependency or platform that explains the code; a bare issue or pull request number; the words review, audit or session when the change itself is about that thing.\nThe message is what the command's -m, --trailer and heredoc values carry. Allow a command whose message you cannot read.\nWhen you refuse, quote each passage and say it belongs in the pull request."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.ts\"",
            "timeout": 30,
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(pacman -Q:*)",
      "Bash(pacman -Ss:*)",
      "Bash(pacman -Si:*)",
      "Bash(pacman -Ql:*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.npmjs.com)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",
      "Bash(bun ./scripts/land.ts *)",
      "Bash(bun ./scripts/landing/tier.ts --pr *)",
      "Bash(bun ./scripts/landing/review-verdict.ts record feature/*)",
      "Bash(bun ./scripts/landing/review-verdict.ts record fix/*)",
      "Bash(bun ./scripts/gates/run-gates.ts *)",
      "Bash(bun test *)",
      "Bash(bun ./scripts/leads/gate.ts collect)",
      "Bash(bun ./scripts/leads/gate.ts collect *)",
      "Bash(bun ./scripts/leads/gate.ts decide --file .leads/verdicts.json)",
      "Bash(bun ./scripts/leads/scan.ts claim *)",
      "Bash(bun ./scripts/leads/scan.ts search *)",
      "Bash(bun ./scripts/leads/scan.ts publish *)",
      "Bash(bun ./scripts/leads/scan.ts release *)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(pacman -S:*)",
      "Bash(pacman -U:*)",
      "Bash(pacman -R:*)"
    ],
    "deny": [
      "Bash(pass :*)",
      "Bash(pass)",
      "Bash(bw get:*)",
      "Bash(bw get)",
      "Bash(bw list:*)",
      "Bash(bw list)",
      "Bash(bw export:*)",
      "Bash(bw export)",
      "Bash(secret-tool :*)",
      "Bash(secret-tool)",
      "Bash(keyctl :*)",
      "Bash(keyctl)",
      "Bash(age -d :*)",
      "Bash(age -d)",
      "Bash(age --decrypt:*)",
      "Bash(gpg -d :*)",
      "Bash(gpg -d)",
      "Bash(gpg --decrypt:*)",
      "Bash(sops -d :*)",
      "Bash(sops -d)",
      "Bash(sops --decrypt:*)",
      "Bash(openssl enc -d:*)",
      "Bash(ansible-vault decrypt:*)",
      "Bash(vault :*)",
      "Bash(vault)",
      "Bash(env :*)",
      "Bash(env)",
      "Bash(printenv :*)",
      "Bash(printenv)",
      "Bash(export -p :*)",
      "Bash(export -p)",
      "Bash(set :*)",
      "Bash(set)",
      "Bash(declare -p:*)",
      "Bash(history :*)",
      "Bash(fc -l:*)",
      "Bash(aws configure list:*)",
      "Bash(aws configure get:*)",
      "Bash(gcloud auth :*)",
      "Bash(gcloud auth)",
      "Bash(kubectl config view :*)",
      "Bash(kubectl config view)",
      "Bash(docker secret :*)",
      "Bash(docker secret)",
      "Bash(git config --get credential :*)",
      "Bash(git config --get credential)",
      "Bash(ssh-add -L :*)",
      "Bash(ssh-add -L)",
      "Bash(ssh-add -l:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*_key)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.gnupg/**)",
      "Read(~/.password-store/**)",
      "Read(~/.config/age/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/secrets.yml)",
      "Read(**/secrets.yaml)",
      "Read(**/vault.yml)",
      "Read(**/vault.yaml)",
      "Read(**/credentials.json)",
      "Read(./secrets/**)",
      "Bash(sudo:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chown -R:*)"
    ]
  }
}
