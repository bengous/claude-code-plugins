// The Stop and each subagent's SubagentStop run the repo's gates, scoped as in pre-push. No fixer: formatting
// stays with the PostToolUse hook `.claude/hooks/format-on-edit.ts`.
{
  // Agents push to dev and land on it with scripts/land.ts; main is the human's release. The kit's pre-bash hook
  // refuses the one-way doors this derives. scripts/land.ts lands a change to a `risky` path only with a clean
  // review verdict for its patch (scripts/landing/review-verdict.ts), reading this list from origin/dev: the paths that
  // move what lands, releases or guards, this file and the gate's own scripts included, and the lint and format
  // configuration whose fixes scripts/headless/renovate-agent.ts vouches for without a review, and what sets a change's
  // tier: the tier scripts, the github-flow skills that publish, dispatch and land, and the commands they read.
  // scripts/land.ts lands a tier:human pull request only once it carries land-ok, which only the human puts on: their
  // own /land <n> (.claude/skills/land) on each pull request <n> lands, or by hand on GitHub; no agent adds it. Each
  // task takes a worktree of its own: a session starting in a checkout another session works in is told so.
  "profile": {
    "landing": { "trunk": "dev", "release": "main" },
    "approvals": {
      "labels": {
        "land-ok": {
          "command": "land",
          "targets": "bun ./scripts/landing/stack.ts resolve {args} --json",
        },
      },
    },
    "review": {
      "risky": [
        "scripts/land.ts",
        "scripts/release.ts",
        "scripts/landing/review-verdict.ts",
        "scripts/landing/landing-lock.ts",
        "scripts/landing/lock-check.ts",
        "scripts/landing/stack.ts",
        "scripts/landing/worker.ts",
        "scripts/headless/renovate-agent.ts",
        "scripts/headless/headless-run.ts",
        ".claude/hooks/renovate-agent.ts",
        "oxlint.config.ts",
        ".oxfmtrc.json",
        "tools/oxlint/local/**",
        "tools/oxlint/anti-slop/**",
        "scripts/gates/check-e2e-green.ts",
        "scripts/releasing/check-plugin-bumps.ts",
        "scripts/landing/ci-wait.ts",
        "scripts/releasing/release-plan.ts",
        "scripts/lib/run.ts",
        ".github/workflows/**",
        "lefthook.yml",
        ".lefthook/**",
        ".claude/__settings.jsonc",
        ".claude/settings.json",
        ".claude/agent-hooks.jsonc",
        "agent-hooks/pre-bash.ts",
        "agent-hooks/user-prompt-expansion.ts",
        ".claude/skills/land/**",
        "agent-hooks/guard/**",
        "agent-hooks/profile.ts",
        "agent-hooks/reader.ts",
        "agent-hooks/config.ts",
        "agent-hooks/json.ts",
        "scripts/lib/breaking-subject.ts",
        "scripts/landing/tier.ts",
        "scripts/landing/tier-floor.ts",
        "scripts/landing/tier.prompt.md",
        "scripts/landing/tier.cases.json",
        ".claude/github-flow.json",
        "github-flow/skills/pr/**",
        "github-flow/skills/dispatch/**",
        "github-flow/skills/shift/**",
      ],
    },
    "worktree": "per-task",
    "commitMessages": "judged",
  },
  "stop": {
    "lanes": {
      "gates": { "on": "**", "takes": "project", "run": "bun ./scripts/gates/run-gates.ts", "timeout": 180 },
    },
  },
}
