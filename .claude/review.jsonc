// scripts/land.ts lands a change to a `risky` path only with a clean review verdict for its patch
// (scripts/landing/review-verdict.ts), reading this list from origin/dev (scripts/landing/tier-floor.ts): the paths
// that move what lands, releases or guards a landing, this file and the gates' own scripts included; the lint and
// format configuration whose fixes scripts/headless/renovate-agent.ts vouches for without a review; and what sets a
// change's tier: the tier scripts, the github-flow skills that publish, dispatch and land, and the commands they read.
// The file holds one key, `risky`, a list of globs from the repository root; any other shape makes every path risky.
{
  "risky": [
    "scripts/land.ts",
    "scripts/release.ts",
    "scripts/landing/review-verdict.ts",
    "scripts/landing/landing-lock.ts",
    "scripts/landing/lock-check.ts",
    "scripts/landing/stack.ts",
    "scripts/landing/worker.ts",
    "scripts/headless/renovate-agent.ts",
    "scripts/headless/headless-run.ts",
    ".claude/hooks/renovate-agent.ts",
    "oxlint.config.ts",
    ".oxfmtrc.json",
    "tools/oxlint/local/**",
    "tools/oxlint/anti-slop/**",
    "scripts/gates/check-e2e-green.ts",
    "scripts/releasing/check-plugin-bumps.ts",
    "scripts/landing/ci-wait.ts",
    "scripts/releasing/release-plan.ts",
    "scripts/lib/run.ts",
    ".github/workflows/**",
    "lefthook.yml",
    ".lefthook/**",
    ".claude/__settings.jsonc",
    ".claude/settings.json",
    ".claude/agent-hooks.jsonc",
    ".claude/review.jsonc",
    ".claude/hooks/land-label.ts",
    ".claude/hooks/guard-land-ok.ts",
    ".claude/skills/land/**",
    "agent-hooks/core/config/reader.ts",
    "agent-hooks/core/config/config.ts",
    "agent-hooks/core/util/json.ts",
    "scripts/lib/breaking-subject.ts",
    "scripts/landing/tier.ts",
    "scripts/landing/tier-floor.ts",
    "scripts/landing/tier.prompt.md",
    "scripts/landing/tier.cases.json",
    ".claude/github-flow.json",
    "github-flow/skills/pr/**",
    "github-flow/skills/dispatch/**",
    "github-flow/skills/shift/**",
  ],
}
