# Ignore downloaded documentation (generated content)
scraped/*

# download-docs.sh writes here by default (OUTPUT_DIR=./downloaded)
__scraping__/scripts/downloaded/

# Keep the directory structure
!scraped/.gitkeep

# Ignore external reference repositories (independent git repos)
references/*

# Keep the directory structure and setup files
!references/.gitkeep
!references/README.md
!references/setup.sh
