{
  "description": "In a git checkout whose top holds .claude/agent-hooks.jsonc: the main checkout's declared worktree.symlinkDirectories linked into a session's worktree, fixers on the text before each write, and Stop lanes on the files the session or subagent changed",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/agent-hooks.ts\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/agent-hooks.ts\" pre-edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/agent-hooks.ts\" stop",
            "timeout": 240,
            "statusMessage": "agent-hooks: lanes on the session scope"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/agent-hooks.ts\" stop",
            "timeout": 240,
            "statusMessage": "agent-hooks: lanes on the session scope"
          }
        ]
      }
    ]
  }
}
