{
  "pre-edit": {
    "exclude": ["**/target/**"],
    "fixers": {
      "rustfmt": { "on": "**/*.rs", "stdin": "rustfmt --edition 2021" },
    },
  },
  "stop": {
    "lanes": {
      "clippy": {
        "on": "**/*.rs",
        "takes": "project",
        "cwd": "pkg",
        "run": "cargo clippy --all-targets -- -D warnings",
        "timeout": 180,
      },
      "cargo-test": { "on": "**/*.rs", "takes": "project", "cwd": "pkg", "run": "cargo test", "timeout": 180 },
    },
  },
}
